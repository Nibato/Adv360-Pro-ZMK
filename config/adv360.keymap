#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      hp: hp {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "hold-preferred";
          tapping-term-ms = <400>;
          quick-tap-ms = <0>;
          require-prior-idle-ms = <0>;
          bindings = <&mo>, <&kp>;
          hold-while-undecided-linger; 
          retro-tap;
      };

      vdp: vdesk_prev {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LG(LC(LEFT))>, <&kp F18>;
        mods = <(MOD_LALT|MOD_RALT)>;
      };

      vdn: vdesk_next {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LG(LC(RIGHT))>, <&kp F19>;
        mods = <(MOD_LALT|MOD_RALT)>;
      };

      wdp: wind_prev {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LA(TAB)>, <&kp LG(LS(LEFT))>;
        mods = <(MOD_LALT|MOD_RALT)>;
      };

      wdn: wind_next {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp LS(LA(TAB))>, <&kp LG(LS(RIGHT))>;
        mods = <(MOD_LALT|MOD_RALT)>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &tog 2                                                           &mo 4 &kp    N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &kp INS                                                          &kp PSCRN    &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &hp 5 LGUI      &kp LCTRL &kp LALT &kp RALT  &kp RCTRL           &hp 5 RGUI   &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 3     &kp GRAVE &mo 6    &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 3
      >;
    };
    game {
      display-name = "Game";
      bindings = <
        &trans     &trans &trans   &trans &trans &trans  &kp ESC                                         &trans     &trans &trans &trans &trans  &trans  &trans
        &trans     &trans &trans   &trans &trans &trans  &trans                                          &trans     &trans &trans &trans &trans  &trans  &trans
        &kp A      &trans &trans   &trans &trans &trans  &trans       &trans &trans &trans &trans        &trans     &trans &trans &trans &trans  &trans  &trans
        &trans     &trans &trans   &trans &trans &trans                      &trans &trans                          &trans &trans &trans &trans  &trans  &trans
        &trans     &trans &trans   &trans &trans               &trans &trans &trans &trans &trans &trans                   &trans &trans &trans  &trans  &trans
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                              &mo 4      &kp N6    &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &kp INS                                                             &kp PSCRN  &kp Y     &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &hp 5 LGUI      &kp LCTRL &kp LALT &kp RALT  &kp RCTRL              &hp 5 RGUI &kp H     &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                        &kp N      &kp KP_N1 &kp KP_N2  &kp KP_N3    &kp KP_ENTER  &kp RSHFT
        &mo 3     &kp GRAVE &mo 6    &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0               &kp UP    &kp DOWN   &kp KP_DOT   &kp RBKT      &mo 3 
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3   &kp F4 &kp F5 &kp F6 &tog 2                                           &mo 4      &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans   &trans &trans &trans  &none                                           &none      &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans   &trans &trans &trans  &hp 5 LGUI   &trans &trans &trans &trans        &hp 5 RGUI &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans   &trans &trans &trans                      &trans &trans                          &trans &trans &trans &trans  &trans  &trans
        &trans &trans &kp LGUI &trans &trans               &trans &trans &trans &trans &trans &trans                   &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                                                  &trans       &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                                                            &bootloader  &none        &none        &none        &none &none &none
        &studio_unlock     &none        &none        &none        &none        &none        &none                     &none       &none      &bt BT_CLR  &none                        &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                                           &kp C_PREV &none                                    &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                           &kp C_PLAY_PAUSE &kp C_STOP  &kp C_NEXT &none       &bl BL_TOG &rgb_ug RGB_TOG                             &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    // hyper {
    //   display-name = "Hyper";
    //   bindings = <
    //     &kp LC(LS(ESC)) &none      &none      &none           &none       &none   &none                                                   &none      &none   &none   &none     &none    &none   &none
    //     &kp LG(TAB)     &kp F24    &none      &kp LG(E)       &kp LG(R)   &kp F20 &none                                                   &none      &none   &none   &none     &none    &kp F17 &none
    //     &kp LG(L)       &none      &none      &kp LG(D)       &none       &none   &hp 4 LGUI    &kp LCTRL &kp LALT &kp RALT &kp RCTRL     &hp 4 RGUI &kp F13 &kp F14 &kp F15   &kp F16  &none   &none
    //     &kp LSHFT       &none      &kp F23    &kp F22         &none       &kp F21                         &none    &kp F18                           &none   &none   &kp LG(I) &none    &none   &kp RSHFT
    //     &none           &none      &none      &none           &none                      &none  &none     &none    &kp F19  &none  &none                     &none   &none     &none    &none   &none
    //   >;
    // };
    hyper {
      display-name = "Hyper";
      bindings = <
        &kp LC(LS(ESC)) &none      &none      &kp LC(LG(F4))  &none       &none   &none                                                      &none      &none            &none        &none       &none             &none             &none
        &kp LG(TAB)     &kp LA(F4) &none      &kp LG(E)       &kp LG(R)   &kp F20 &none                                                      &none      &none            &none        &none       &none             &kp F17           &none
        &kp LG(L)       &none      &none      &kp LG(D)       &none       &tog 1  &hp 5 LGUI    &kp LCTRL &kp LALT &kp RALT    &kp RCTRL     &hp 5 RGUI &wdp             &none        &none       &wdn              &none             &none
        &kp LSHFT       &none      &kp F23    &kp F22         &none       &kp F21                         &none    &vdp                                 &none            &none        &kp LG(I)   &none             &none             &kp RSHFT
        &none           &none      &none      &none           &none                      &none  &none     &none    &vdn        &none  &none                              &none        &none       &none             &none             &none
      >;
    };
    nav {
      display-name = "Nav";
      bindings = <
        &none           &none      &none      &none           &kp END     &none   &none                                                   &none      &kp HOME &none     &none     &none     &kp HOME &none
        &none           &none      &none      &none           &none       &none   &none                                                   &none      &none    &kp PGUP  &none     &none     &none    &none
        &none           &none      &none      &kp PGDN        &none       &none   &none         &kp LCTRL &kp LALT &kp RALT &kp RCTRL     &none      &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &none    &none
        &kp LSHFT       &none      &none      &none           &none       &none                           &none    &none                             &none    &none     &none     &none     &none    &kp RSHFT
        &none           &none      &none      &none           &none                      &none  &none     &none    &none    &none  &none                      &none     &none     &none     &none    &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
